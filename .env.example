# ─── Frontend (all safe to expose, prefixed NEXT_PUBLIC_) ───────────────────
NEXT_PUBLIC_PRIVY_APP_ID=cmoye0mtn02370cjji62wkprp
NEXT_PUBLIC_SCROLL_SEPOLIA_RPC=https://sepolia-rpc.scroll.io
NEXT_PUBLIC_PIMLICO_API_KEY=pim_Yf3nPURNmMhA4hjSG7QCDB
NEXT_PUBLIC_PRAGUE_EXPLORER_ADDRESS=
NEXT_PUBLIC_EAS_SCHEMA_UID=
# Block where PragueExplorer was deployed. Used to bound eth_getLogs scans on the Scroll
# Sepolia public RPC, which rejects ranges larger than ~10k blocks. Set to your actual
# deploy block (visible in the forge script output or scrollscan). The code defaults to
# 18052900 if this is unset — safe to leave blank until you know the exact block.
NEXT_PUBLIC_PRAGUE_EXPLORER_DEPLOY_BLOCK=18052868
# Set after deploying Semaphore v4 with:
#   pnpm dlx @semaphore-protocol/cli@latest deploy --network scroll-sepolia
# Allows group member fetching without an extra on-chain call.
NEXT_PUBLIC_SEMAPHORE_ADDRESS=

# ─── Server / deploy only (NEVER shipped to the client bundle) ───────────────
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Get from https://scrollscan.com — register free account, used for contract verification
SCROLLSCAN_API_KEY=

# ─── Foundry-only (no NEXT_PUBLIC_ prefix — not exposed to the browser) ──────
# Set after deploying Semaphore v4. Deploy.s.sol reads this via vm.envAddress().
SEMAPHORE_ADDRESS=
